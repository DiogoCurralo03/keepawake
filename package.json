{
  "name": "keepawake-windows",
  "version": "1.0.1-rc.1",
  "description": "Keep Windows awake with a native tray and per-user startup.",
  "type": "module",
  "bin": {
    "keepawake": "bin/keepawake.js"
  },
  "author": "Italo Almeida",
  "repository": {
    "type": "git",
    "url": "https://github.com/italoalmeida0/keepawake.git"
  },
  "bugs": {
    "url": "https://github.com/italoalmeida0/keepawake/issues"
  },
  "homepage": "https://github.com/italoalmeida0/keepawake#readme",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "src",
    "bin",
    "scripts",
    "recovered",
    "AGENTS.md",
    "install.cmd",
    "uninstall.cmd",
    "LICENSE",
    "README.md",
    "package-lock.json"
  ],
  "scripts": {
    "start": "node bin/keepawake.js start",
    "install-local": "node scripts/install.js",
    "uninstall-local": "node scripts/uninstall.js",
    "check": "node scripts/check.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "package": "node scripts/package.js"
  },
  "dependencies": {
    "koffi": "^3.3.5"
  }
}
